{
  "name": "pokemon-meeting-reminder",
  "version": "0.1.0",
  "description": "Windows tray app that sends a Pokémon across your desktop before meetings.",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "kevinc",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dev": "electron . --devtools",
    "test-scene": "electron . --test",
    "fetch-media": "node scripts/fetch-media.js",
    "build-manifest": "node scripts/build-manifest.js",
    "build-icons": "node scripts/build-icons.js",
    "test": "node --test test/",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "build": {
    "appId": "com.kevinc.pokemon-meeting-reminder",
    "productName": "Pokémon Meeting Reminder",
    "files": [
      "**/*",
      "!media/**",
      "!browser-extension/**",
      "!test/**",
      "!scripts/**",
      "!vendor/**",
      "!build/**",
      "!dist/**",
      "!.claude/**",
      "!PLAN.md",
      "!README.md",
      "!ATTRIBUTION.md",
      "!CLAUDE.local.md"
    ],
    "extraResources": [
      {
        "from": "media",
        "to": "media",
        "filter": [
          "**/*",
          "!bgm/README.md"
        ]
      },
      {
        "from": "browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "ATTRIBUTION.md",
        "to": "ATTRIBUTION.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kevin-jake",
      "repo": "pokemon-meeting-reminder",
      "releaseType": "draft"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  }
}
