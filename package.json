{
  "name": "pokemon-meeting-reminder",
  "version": "0.1.0",
  "description": "Windows tray app that sends a Pokémon across your desktop before meetings.",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "kevinc",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dev": "electron . --devtools",
    "test-scene": "electron . --test",
    "fetch-media": "node scripts/fetch-media.js",
    "build-manifest": "node scripts/build-manifest.js",
    "build-icons": "node scripts/build-icons.js",
    "test": "node --test test/"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "build": {
    "appId": "com.kevinc.pokemon-meeting-reminder",
    "productName": "Pokémon Meeting Reminder",
    "files": [
      "**/*",
      "!media/**",
      "!browser-extension/**",
      "!test/**",
      "!scripts/**",
      "!PLAN.md",
      "!CLAUDE.local.md"
    ],
    "extraResources": [
      {
        "from": "media",
        "to": "media",
        "filter": [
          "**/*",
          "!bgm/README.md"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
